# =============================================================================
# shuo -- environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real
# credentials. Everything below is read at process start.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────
PORT=3040
DRAIN_TIMEOUT=300

# Your externally reachable base URL, no trailing slash.
# Dev: your ngrok domain (https://dashboard.ngrok.com/domains).
# Prod: the ALB / Elastic IP hostname.
# The carrier fetches /answer here and forks media to /ws here.
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Where per-call latency traces are written.
# Defaults to <system temp>/shuo -- works on Windows and Linux both.
# SHUO_TRACE_DIR=./traces


# ── Configuration API (`python config_api.py`) ───────────────────────
# The REST layer the Next.js control panel writes to. A SEPARATE PROCESS
# on a SEPARATE PORT from the call server above, deliberately: a save
# writes to disk, and a blocking write on the loop that paces the player's
# 20ms frames is permanent stream delay for the rest of a live call.
CONFIG_API_PORT=3041

# Loopback by default, and that is the security boundary -- bound to
# 127.0.0.1 there is no remote caller to authenticate. Binding anywhere
# else WITHOUT the token below is refused at startup, not warned about:
# this API decides what the twin says on a real phone call.
# CONFIG_API_HOST=127.0.0.1

# Where the operator's configuration is stored. NOT under the temp
# directory the way traces are -- a trace is disposable, this has to
# survive a restart. Defaults to <repo>/var/agent_config.json.
# SHUO_CONFIG_PATH=./var/agent_config.json

# Optional shared secret for the config API. Deliberately NOT
# SHUO_ADMIN_TOKEN: that one is very likely already set for /call, and the
# panel sends no auth header today, so reusing it would silently break
# every save. Set this only alongside the matching header in the panel's
# lib/api/transport.ts.  Send as: X-Shuo-Config-Token
#   generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# SHUO_CONFIG_API_TOKEN=

# Where the config API finds the CALL server, for the test-call button
# (POST /v1/test-call). Loopback, because both run on the same host; the two
# stay separate processes and speak HTTP, never a shared import.
#
# SHUO_ADMIN_TOKEN below must be set for the test call to work -- it is the
# credential :3041 presents to :3040, and it is why the panel can *ask* for
# a call without being able to place one. `GET /health` on the config API
# reports `test_call_ready` so this is diagnosable without a phone.
# SHUO_CALL_SERVER_URL=http://127.0.0.1:3040


# ── Carrier selection ────────────────────────────────────────────────
# vobiz  = production target (AWS ap-south-1, Indian DID)
# twilio = regression path only; cannot legally originate to India from
#          an Indian number, and costs ~Rs 4.36/min to Indian mobiles.
CARRIER=vobiz


# ── Vobiz (primary carrier) ──────────────────────────────────────────
# Base URL WITHOUT the trailing /Account/ segment -- shuo appends
# /Account/{auth_id}/Call/ itself. Path casing is significant: Vobiz
# returns 401 (not 404) on wrong casing, so do not lowercase this.
VOBIZ_BASE_URL=https://api.vobiz.ai/api/v1

VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token

# The 10-digit Indian DID calls originate from, in E.164 format.
# A dummy value is fine for local testing -- it is only used as the
# `from` field when placing a call.
VOBIZ_PHONE_NUMBER=+911234567890


# ── Twilio (fallback carrier, optional) ──────────────────────────────
# Only needed when CARRIER=twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_EDGE=frankfurt
# TWILIO_REGION=us1
# Legacy alias for PUBLIC_URL, still honoured so old .env files work.
# TWILIO_PUBLIC_URL=https://your-public-url.example.com


# ── Digital Twin persona ─────────────────────────────────────────────
# Persona used when nothing more specific applies.
# Test Phase 1 persona is the job candidate being interviewed.
PERSONA=candidate

# Inbound persona routing: which twin answers which number.
# Format: <e164>:<persona>,<e164>:<persona>
# PERSONA_ROUTES=+911234567890:receptionist,+919999:recruiter


# ── Call recording ───────────────────────────────────────────────────
# Dual-channel (stereo) recording: caller on one channel, agent on the
# other. This is a test instrument, not a feature -- channel separation
# is how we score character breaks, review interruptions, and measure
# real mouth-to-ear latency.
RECORD_CALLS=true


# ── Operator endpoint security ───────────────────────────────────────
# PUBLIC_URL is internet-reachable by definition and the server binds
# 0.0.0.0, so /call (spends PSTN money), /calls/live (contains what the
# caller said), /calls/current/hangup (ends a live call), /trace/latest and
# /bench/ttft (burns paid LLM credits) are gated behind this shared secret.
# Send it as the X-Shuo-Admin-Token header.
#
# The config API reads the SAME variable and presents it to the call server
# on the panel's behalf, so set it in the environment of BOTH processes.
# That is the whole security story for the test-call button: the browser
# never holds this, so reaching the panel is not the same as being able to
# place calls.
#
# Leave it UNSET and those endpoints refuse to serve at all --
# they fail closed, never open. Inbound calls do not need it.
#   generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SHUO_ADMIN_TOKEN=

# Signs the wss:// URL placed in the answer XML, binding the media socket
# to one persona, direction and expiry. Defaults to VOBIZ_AUTH_TOKEN,
# which is already set and already secret -- override only if you want
# stream tokens rotated independently of the carrier credential.
# SHUO_STREAM_SECRET=


# ── Webhook security ─────────────────────────────────────────────────
# Carrier webhook signatures are validated unconditionally: a missing
# signature header is a failure, not a reason to skip the check.
# Only set this false when pointing at a carrier whose signing secret you
# do not hold. The bundled fake-Vobiz stub signs correctly, so the test
# suite does NOT need this.
VALIDATE_WEBHOOK_SIGNATURES=true


# ── Speech-to-Text ───────────────────────────────────────────────────
# Current: Deepgram Flux (STT + turn detection, EU endpoint).
DEEPGRAM_API_KEY=your_deepgram_api_key

# Phase 3: Sarvam saaras:v3 -- India-hosted, 8kHz native, en-IN codemix.
# SARVAM_API_KEY=your_sarvam_api_key


# ── LLM ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile

# Used by /bench/ttft, and by the OpenAI-compatible client.
OPENAI_API_KEY=your_openai_api_key


# ── Text-to-Speech ───────────────────────────────────────────────────
# ElevenLabs remains the default/production-quality primary provider.
# Pocket TTS is the optional local CPU test provider and pre-audio emergency
# fallback. See docs/TTS_PROVIDERS.md for the exact safety/acceptance boundary.
#
# Default production behavior (unchanged):
TTS_PROVIDER=elevenlabs
#
# Optional emergency fallback. Install the optional profile first:
#   python -m pip install -r requirements-pocket-tts.txt
# When configured, an absent ELEVENLABS_API_KEY selects Pocket without
# contacting ElevenLabs; runtime ElevenLabs failures can fall back only before
# the first ElevenLabs audio chunk of that turn.
# TTS_FALLBACK_PROVIDER=pocket
#
# Cost-free functional testing can instead select Pocket directly and leave the
# fallback empty. Prefer an inline override for one-off tests so production
# configuration is not accidentally changed.
# TTS_PROVIDER=pocket
# TTS_FALLBACK_PROVIDER=
#
# Validated local path uses Pocket's built-in catalog voice alias `alba`, which
# does not require Hugging Face login or gated voice-cloning weights.
# POCKET_TTS_VOICE=alba
# Custom/clone voice URLs are outside the currently validated SHUO path.
#
# Pocket native PCM is contained inside its provider module and converted to
# mono G.711 mu-law/8k before the existing player/carrier boundary. No raw audio
# file is written.

# ElevenLabs, decided 2026-07-22 after listening to candidates. Sarvam
# and Cartesia were evaluated and rejected: neither sounded as natural on
# Indian English. This supersedes the Phase 4 "move to Cartesia" plan.
#
# The socket requests output_format=ulaw_8000, so audio arrives already in
# the only codec that reaches the caller (rules.md C1). Chunk size is the
# vendor's business -- the player reframes to 20ms frames itself.
# Required when ElevenLabs is selected without a Pocket fallback.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Who the twin sounds like. Keep it here rather than passing it per call.
#
# 🔴 A voice being listed by /v1/voices does NOT mean you can synthesise it
# (context.md decision 29). Voices with `category: professional` are library
# voices and need a paid entitlement; on a free plan they return
# `payment_required` and emit ZERO audio -- the call is silent, not merely
# off-accent. `category: premade` voices work on every plan. Prove a voice
# by synthesising with it, never by finding it in the listing.
#
#   MmiGAbOYCaIFzgNItUWa  Krish  - professional, indian   <- persona-correct,
#                                                            needs a paid plan
#   JBFqnCBsd6RMkjVDRZzb  George - premade, british       <- works everywhere
#   onwK4e9ZLuTAKqWW03F9  Daniel - premade, british       <- alternative male
#
# British is the least-wrong stand-in for Indian English, but it is still a
# character break (CLAUDE.md §4.3, rules.md D3/D4). Restore Krish as soon as
# the plan allows it.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# =============================================================================
# PUSH NOTIFICATIONS (Phase 8 W5d) -- optional, and OFF unless you set the URL
# =============================================================================
#
# Pushes a notification when an inbound call starts, is missed, or fails. The
# poller lives in the config API process (:3041) and never in the call server:
# an outbound TLS handshake has no business on the loop that paces a 160-byte
# frame every 20ms (context.md decision 32).
#
# ntfy.sh needs no account, no key and no card, and its free app turns this
# into a real push on your handset. There is deliberately no SMS path: A2P SMS
# to an Indian number requires DLT registration, which CLAUDE.md §2.1 puts out
# of scope, and every provider trial expires or starts billing.
#
# 🔴 THE TOPIC NAME IS THE ENTIRE SECRET. Anyone who knows it reads every
# notification about every call. Generate it long and random, keep it here, and
# never put it in the panel or a log line -- nothing in the code ever prints it,
# and /health reports https://ntfy.sh/(redacted).
#
#   SHUO_NOTIFY_URL=https://ntfy.sh/shuo-$(openssl rand -hex 12)
#
# 🔴 This is the ONLY thing in the system that sends call data off the machine.
# It carries metadata -- direction, number, persona, duration -- and never a
# transcript. Whether even that is acceptable is a deployment decision, which is
# why it is unset by default. Test your wiring by pointing this at any local
# HTTP server before trusting the real one.
#
# SHUO_NOTIFY_URL=
#
# Optional bearer credential, for a self-hosted ntfy or a target that needs one.
# A public ntfy.sh topic does not.
# SHUO_NOTIFY_TOKEN=
